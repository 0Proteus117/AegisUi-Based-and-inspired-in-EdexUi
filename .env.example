# AegisUi / EdexUi-Eng local environment example.
#
# Copy this file to `.env` for local development only.
# Never commit `.env`; it is ignored by Git.

# Optional: enables TomTom traffic tiles.
# Get your own key from TomTom and paste it in your private `.env`.
AEGISUI_TOMTOM_API_KEY=

# Optional: start in a stricter local/offline posture.
# 1 = skip optional online work where supported.
AEGISUI_OFFLINE_MODE=0

# Optional: skip GitHub release checks on startup.
AEGISUI_DISABLE_UPDATE_CHECK=0

# Optional: override the app-data folder used by helper scripts.
# The Electron app itself normally uses:
# ~/Library/Application Support/EdexUi-Eng
AEGISUI_USER_DATA_DIR=

# Optional: initial project shown by the DEVELOPER workspace.
# Prefer developer-deck.json for day-to-day personal configuration.
AEGISUI_DEVELOPER_PROJECT=

# Future optional integrations.
# These are documented placeholders only; v1.9.x does not call these providers.
AEGISUI_STEAMGRIDDB_API_KEY=
AEGISUI_ADSB_API_KEY=
AEGISUI_AIS_API_KEY=
