{
  "name": "AegisUi local profile",
  "description": "Copy to user-config.local.json for private local notes. Do not put API keys here.",
  "settings": {
    "offlineMode": false,
    "disableUpdateCheck": false,
    "activeWorkspace": "hub"
  },
  "map": {
    "baseTiles": {
      "provider": "OpenStreetMap",
      "onlineRequired": true
    },
    "traffic": {
      "provider": "TomTom",
      "enabled": false,
      "apiKeyEnv": "AEGISUI_TOMTOM_API_KEY"
    },
    "radar": {
      "provider": "RainViewer",
      "enabled": true,
      "apiKeyRequired": false
    },
    "layers": {
      "storage": "map-layers.json",
      "ROAD_TRAFFIC": {
        "enabled": false,
        "requiresApiKey": true
      },
      "WEATHER_RADAR": {
        "enabled": true,
        "requiresApiKey": false
      },
      "AIR_TRAFFIC": {
        "enabled": false,
        "mode": "placeholder"
      },
      "MARITIME_AIS": {
        "enabled": false,
        "mode": "placeholder"
      },
      "SATELLITES": {
        "enabled": false,
        "mode": "placeholder"
      },
      "OCEAN_ALERTS": {
        "enabled": false,
        "mode": "placeholder"
      }
    }
  },
  "localData": {
    "projects": "projects.json",
    "musicPlaylists": "music-playlists.json",
    "mapLayers": "map-layers.json",
    "launchBayGames": "launch-bay-games.json",
    "developerDeck": "developer-deck.json",
    "agentCommand": "agent-command.json",
    "workspaceState": "workspace-state.json",
    "settings": "settings.json",
    "shortcuts": "shortcuts.json"
  },
  "launchBay": {
    "storage": "launch-bay-games.json",
    "autoDetectGames": false,
    "cloudArtwork": false,
    "futureArtworkProvider": "SteamGridDB"
  },
  "developerDeck": {
    "storage": "developer-deck.json",
    "activeProjectPath": "/Users/you/Projects/my-project",
    "favoriteScripts": ["start", "dev", "test", "build"],
    "runScriptsByDefault": false,
    "gitWriteActions": false
  },
  "agentCommand": {
    "storage": "agent-command.json",
    "autonomyEnabled": false,
    "allowedPermissionLevels": [0, 1],
    "externalProviders": false,
    "cloudContextSharing": false,
    "automaticFileWrites": false,
    "automaticCommits": false
  },
  "workspaceState": {
    "storage": "workspace-state.json",
    "activeWorkspace": "hub",
    "navigationMode": "pinned-hub-scroll-rail"
  }
}
